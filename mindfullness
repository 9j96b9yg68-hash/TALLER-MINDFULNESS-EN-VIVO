<script>
  // Petals
  document.addEventListener('DOMContentLoaded', () => {
    const hero = document.querySelector('.hero');
    for (let i = 0; i < 18; i++) {
      const p = document.createElement('div');
      p.className = 'petal';
      p.style.cssText = `left:${Math.random()*100}%;width:${8+Math.random()*10}px;height:${14+Math.random()*14}px;animation-duration:${8+Math.random()*12}s;animation-delay:${Math.random()*14}s;`;
      hero.appendChild(p);
    }
  });

  // YouTube modal
  function openYT() {
    document.getElementById('ytModal').classList.add('open');
    document.getElementById('ytIframe').src = 'https://www.youtube.com/embed/FiLKGKaqblc?autoplay=1';
  }
  function closeYT(e) {
    if (!e || e.target === document.getElementById('ytModal') || e.currentTarget.tagName === 'BUTTON') {
      document.getElementById('ytModal').classList.remove('open');
      document.getElementById('ytIframe').src = '';
    }
  }

  // Quiz
  const answers = { q1:'C', q2:'C', q3:'D', q4:'B', q5:'B', q6:'D', q7:'A', q8:'A', q9:'B', q10:'A' };
  const explanations = {
    q1:  'Correcto. Mindfulness es un entrenamiento mental para estar en el momento preciso.',
    q2:  'Correcto. La mente crea ilusiones para llenar los vacíos de información.',
    q3:  'Correcto. El cuerpo siempre está en el presente, a diferencia de la mente.',
    q4:  'Correcto. Aceptar es fluir con el momento, no rendirse.',
    q5:  'Correcto. La "mente de mono" describe ese saltar constante de pensamiento en pensamiento.',
    q6:  'Correcto. Los ruidos se integran en la práctica como parte natural de la vida.',
    q7:  'Correcto. Reclinarse para dormirse no es una postura recomendada.',
    q8:  'Correcto. El arte de darse cuenta es reconocer la distracción y volver al presente.',
    q9:  'Correcto. Resistirse a la realidad genera sufrimiento mental y rumiación.',
    q10: 'Correcto. Se enfoca la atención en el punto entre las fosas nasales.'
  };

  let answered = 0;
  let score = 0;
  const total = 10;

  function answer(btn, qId, selected) {
    const card = document.getElementById(qId);
    if (card.classList.contains('answered-correct') || card.classList.contains('answered-wrong')) return;

    const correct = answers[qId];
    const allBtns = card.querySelectorAll('.option-btn');
    allBtns.forEach(b => { b.disabled = true; });

    const fb = document.getElementById('fb-' + qId);

    if (selected === correct) {
      btn.classList.add('correct');
      card.classList.add('answered-correct');
      fb.innerHTML = `<span class="feedback-icon">✅</span> ${explanations[qId]}`;
      fb.className = 'feedback correct show';
      score++;
    } else {
      btn.classList.add('wrong');
      card.classList.add('answered-wrong');
      // Reveal correct
      allBtns.forEach(b => {
        if (b.textContent.startsWith(correct + '.')) b.classList.add('reveal-correct');
      });
      fb.innerHTML = `<span class="feedback-icon">❌</span> Incorrecto. La respuesta correcta es <strong>${correct}</strong>: ${explanations[qId]}`;
      fb.className = 'feedback wrong show';
    }

    answered++;
    updateProgress();
    if (answered === total) showScore();
  }

  function updateProgress() {
    document.getElementById('progressLabel').textContent = `${answered} / ${total} respondidas`;
    document.getElementById('progressBar').style.width = `${(answered/total)*100}%`;
  }

  function showScore() {
    const sb = document.getElementById('scoreBoard');
    document.getElementById('scoreNum').textContent = `${score}/${total}`;
    const msgs = [
      [10, '🌟 ¡Perfecto! Eres una maestra del mindfulness.'],
      [8,  '🎉 ¡Excelente! Aprendiste muy bien la sesión.'],
      [6,  '👍 ¡Muy bien! Sigue practicando la atención plena.'],
      [4,  '🌱 Vas por buen camino. Te animamos a ver el video otra vez.'],
      [0,  '🧘 No importa, cada inicio es válido. ¡Vuelve a intentarlo!']
    ];
    const msg = msgs.find(([min]) => score >= min);
    document.getElementById('scoreMsg').textContent = msg[1];
    sb.classList.add('visible');
    sb.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function resetQuiz() {
    answered = 0; score = 0;
    document.getElementById('scoreBoard').classList.remove('visible');
    updateProgress();
    for (let i = 1; i <= 10; i++) {
      const card = document.getElementById('q' + i);
      card.classList.remove('answered-correct','answered-wrong');
      card.querySelectorAll('.option-btn').forEach(b => {
        b.disabled = false;
        b.classList.remove('correct','wrong','reveal-correct');
      });
      const fb = document.getElementById('fb-q' + i);
      fb.className = 'feedback';
      fb.innerHTML = '';
    }
    document.getElementById('quizContainer').scrollIntoView({ behavior:'smooth' });
  }
</script>
</body>
